#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_GOOGLE_include_directive : require

#include "util-microfacet-prelude.glsl"
#include "util-microfacet-materialx-reference.glsl"

layout(buffer_reference, scalar) buffer F32v2Buffer { f32v2 data[]; };
layout(buffer_reference, scalar) buffer F32v3Buffer { f32v3 data[]; };

// per sample: f32v3(dotNorWi, dotNorWo, alpha). output: f32v2(mine, materialx)
// materialx ships raw G2, not the 1/(4*NdotL*NdotV)-folded visibility form
// cull uses, so the fold is applied here (not inside the ported reference)
// to compare the same physical quantity.
layout(push_constant, scalar) uniform PC {
	layout(offset = 128) uint64_t inVa;
	uint64_t outVa;
	uint count;
} pc;

layout(local_size_x = 64) in;

void main() {
	u32 i = gl_GlobalInvocationID.x;
	if (i >= pc.count) { return; }
	const f32v3 s = F32v3Buffer(pc.inVa).data[i];
	const f32 mine = utilMicrofacetSmithGgxVisibility(s.x, s.y, s.z);
	const f32 ref = mx_ggx_smith_G2(s.x, s.y, s.z) / (4.0f * s.x * s.y);
	F32v2Buffer(pc.outVa).data[i] = f32v2(mine, ref);
}
