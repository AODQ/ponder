#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require

layout(set = 0, binding = 3) uniform accelerationStructureEXT vkofTlas;

layout(buffer_reference, scalar) buffer U32Buffer {
	uint data[];
};

layout(push_constant, scalar) uniform PC {
	layout(offset = 128) uint64_t outVa;
	uint width;
	uint height;
} pc;

// pinhole camera outside the open front of the box, looking down +z.
// the cornell box interior spans [-1,1]^3 with the front face (z=-1) open.
const vec3 skCameraOrigin = vec3(0.0, 0.0, -3.0);
const float skTanHalfFov = 0.4;
const uint skMissIndex = 0xFFFFFFFFu;

layout(local_size_x = 8, local_size_y = 8) in;

void main() {
	uint px = gl_GlobalInvocationID.x;
	uint py = gl_GlobalInvocationID.y;
	if (px >= pc.width || py >= pc.height) { return; }

	// ndc in [-1,1]; image row 0 is the top of the frame (+y in world)
	float ndcX = (2.0 * (float(px) + 0.5) / float(pc.width) - 1.0);
	float ndcY = (2.0 * (float(py) + 0.5) / float(pc.height) - 1.0);
	vec3 dir = normalize(
		vec3(ndcX * skTanHalfFov, -ndcY * skTanHalfFov, 1.0)
	);

	rayQueryEXT rq;
	rayQueryInitializeEXT(
		/*rayQuery=*/rq,
		/*topLevel=*/vkofTlas,
		/*rayFlags=*/gl_RayFlagsOpaqueEXT,
		/*cullMask=*/0xFF,
		/*origin=*/skCameraOrigin,
		/*tMin=*/0.001,
		/*direction=*/dir,
		/*tMax=*/100.0
	);
	while (rayQueryProceedEXT(rq)) { }

	bool hit = (
		rayQueryGetIntersectionTypeEXT(/*rayQuery=*/rq, /*committed=*/true)
		!= gl_RayQueryCommittedIntersectionNoneEXT
	);
	uint wallIndex = (
		hit
		? uint(rayQueryGetIntersectionInstanceCustomIndexEXT(
			/*rayQuery=*/rq, /*committed=*/true
		))
		: skMissIndex
	);
	U32Buffer(pc.outVa).data[py * pc.width + px] = wallIndex;
}
