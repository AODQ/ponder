#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

// openPbrThinWalledSubsurfaceEvaluateF / openPbrThinWalledSubsurfacePdf
// (util-material-openpbr-diffuse.glsl) at explicit (nor, wi, wo) triples,
// plus the materialx oren-nayar reference the reflection side must match.

layout(set = 0, binding = 0) uniform sampler2D vkofTextures[];

#include "util-random.glsl"
#include "util-material-openpbr-tables.glsl"

// constants normally provided by util-material-openpbr.glsl; the full
// material include chain pulls in every lobe, so the diffuse-only prelude
// is replicated here instead (values must match util-material-openpbr.glsl)
#define IPI 0.31830988618379067154
#define PI  3.14159265358979323846
#define TAU 6.28318530717958647692
const float skFon1 = 0.5f - 2.0f / (3.0f * PI);
const float skFon2 = 2.0f / 3.0f - 28.0f / (15.0f * PI);

#include "util-material-openpbr-shared.h"
#include "util-material-openpbr-thinfilm.glsl"
#include "util-material-openpbr-microfacet.glsl"
#include "util-material-openpbr-diffuse.glsl"
#include "util-eon-materialx-reference.glsl"

layout(buffer_reference, scalar) buffer F32Buffer { f32 data[]; };

// per sample, 14 floats in: nor.xyz, wi.xyz, wo.xyz,
// baseDiffuseRoughness, subsurfaceScatterAnisotropy, subsurfaceColor.rgb.
// 8 floats out: f.rgb, pdf, materialx reference f.rgb (the albedo-1 lobe
// shape only, unscaled by S or the split), unused
layout(push_constant, scalar) uniform PC {
	layout(offset = 128) uint64_t inVa;
	uint64_t outVa;
	uint count;
} pc;

layout(local_size_x = 64) in;

void main() {
	const u32 i = gl_GlobalInvocationID.x;
	if (i >= pc.count) {
		return;
	}
	F32Buffer inBuf = F32Buffer(pc.inVa);
	const u32 base = i * 14u;
	const f32v3 nor = (
		f32v3(inBuf.data[base+0u], inBuf.data[base+1u], inBuf.data[base+2u])
	);
	const f32v3 wi = (
		f32v3(inBuf.data[base+3u], inBuf.data[base+4u], inBuf.data[base+5u])
	);
	const f32v3 wo = (
		f32v3(inBuf.data[base+6u], inBuf.data[base+7u], inBuf.data[base+8u])
	);

	OpenPbrMaterial mat;
	mat.baseDiffuseRoughness = inBuf.data[base+9u];
	mat.subsurfaceScatterAnisotropy = inBuf.data[base+10u];
	mat.subsurfaceColor = (
		f32v3(inBuf.data[base+11u], inBuf.data[base+12u], inBuf.data[base+13u])
	);

	const f32v3 f = openPbrThinWalledSubsurfaceEvaluateF(mat, nor, wi, wo);
	const f32 pdf = (
		openPbrThinWalledSubsurfacePdf(
			dot(nor, wo), mat.subsurfaceScatterAnisotropy
		)
	);

	// the reference lobe is evaluated on the same mirrored wo the lib uses,
	// so it covers the transmission side too
	const f32 dotNorWo = dot(nor, wo);
	const f32v3 woLobe = dotNorWo < 0.0f ? wo - 2.0f * dotNorWo * nor : wo;
	const f32v3 reference = (
		mxOrenNayarCompensatedDiffuse(
			max(dot(nor, wi), 0.0f), max(dot(nor, woLobe), 0.0f),
			dot(wi, woLobe), mat.baseDiffuseRoughness, f32v3(1.0f)
		)
		* IPI
	);

	F32Buffer outBuf = F32Buffer(pc.outVa);
	const u32 outBase = i * 8u;
	outBuf.data[outBase+0u] = f.x;
	outBuf.data[outBase+1u] = f.y;
	outBuf.data[outBase+2u] = f.z;
	outBuf.data[outBase+3u] = pdf;
	outBuf.data[outBase+4u] = reference.x;
	outBuf.data[outBase+5u] = reference.y;
	outBuf.data[outBase+6u] = reference.z;
	outBuf.data[outBase+7u] = 0.0f;
}
