#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_GOOGLE_include_directive : require

#include "util-fresnel.glsl"
#include "util-fresnel-materialx-reference.glsl"

layout(buffer_reference, scalar) buffer F32v2Buffer { f32v2 data[]; };

// per sample: f32v2(cosTheta, eta). output: f32v2(mine, materialx)
layout(push_constant, scalar) uniform PC {
	layout(offset = 128) uint64_t inVa;
	uint64_t outVa;
	uint count;
} pc;

layout(local_size_x = 64) in;

void main() {
	u32 i = gl_GlobalInvocationID.x;
	if (i >= pc.count) { return; }
	const f32v2 ce = F32v2Buffer(pc.inVa).data[i];
	const f32 mine = utilFresnelDielectric(ce.x, ce.y);
	const f32 ref = mxFresnelDielectric(ce.x, ce.y);
	F32v2Buffer(pc.outVa).data[i] = f32v2(mine, ref);
}
