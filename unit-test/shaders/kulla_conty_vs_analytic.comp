#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

layout(set = 0, binding = 0) uniform sampler2D vkofTextures[];

#include "util-energy-compensation.glsl"

layout(buffer_reference, scalar) buffer F32v2Buffer { f32v2 data[]; };

// per sample: f32v2(mu, roughness). output: f32v2(table, analytic)
// analytic uses f0=f90=1 (perfect fresnel single-scatter albedo), which is
// the same physical quantity the kulla-conty table stores
layout(push_constant, scalar) uniform PC {
	layout(offset = 128) uint64_t inVa;
	uint64_t outVa;
	uint tableHandle;
	uint count;
} pc;

layout(local_size_x = 64) in;

void main() {
	u32 i = gl_GlobalInvocationID.x;
	if (i >= pc.count) { return; }
	const f32v2 s = F32v2Buffer(pc.inVa).data[i];
	const f32 table = (
		utilMicrofacetDielectricEnergyCompensationKullaConty(
			pc.tableHandle, s.x, s.y
		)
	);
	const f32 analytic = utilMicrofacetGgxDirectionalAlbedo(s.x, s.y, 1.0f, 1.0f);
	F32v2Buffer(pc.outVa).data[i] = f32v2(table, analytic);
}
