#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

layout(set = 0, binding = 0) uniform sampler2D vkofTextures[];

#include "util-material-openpbr-tables.glsl"

#define IPI 0.31830988618379067154
#define PI  3.14159265358979323846
#define TAU 6.28318530717958647692
const float skFon1 = 0.5f - 2.0f / (3.0f * PI);
const float skFon2 = 2.0f / 3.0f - 28.0f / (15.0f * PI);

#include "util-material-openpbr-shared.h"
#include "util-material-openpbr-thinfilm.glsl"
#include "util-material-openpbr-microfacet.glsl"
#include "util-material-openpbr-ibl.glsl"

layout(buffer_reference, scalar) buffer F32Buffer { f32 data[]; };
layout(buffer_reference, scalar) buffer F32v3Buffer { f32v3 data[]; };

// same 11-float layout as coat_ibl_furnace_integrate.comp
layout(push_constant, scalar) uniform PC {
	layout(offset = 128) uint64_t inVa;
	uint64_t outVa;
	uint count;
} pc;

layout(local_size_x = 64) in;

void main() {
	u32 i = gl_GlobalInvocationID.x;
	if (i >= pc.count) { return; }
	F32Buffer inBuf = F32Buffer(pc.inVa);
	u32 base = i * 11u;
	const f32 muI = inBuf.data[base+0u];

	OpenPbrMaterial mat;
	mat.coatWeight = inBuf.data[base+1u];
	mat.coatRoughness = inBuf.data[base+2u];
	mat.coatRoughnessAnisotropy = 0.0f;
	mat.coatIor = inBuf.data[base+3u];
	mat.coatDarkening = inBuf.data[base+4u];
	mat.coatColor = f32v3(inBuf.data[base+5u]);
	mat.specularRoughness = inBuf.data[base+6u];
	mat.specularRoughnessAnisotropy = 0.0f;
	mat.specularWeight = inBuf.data[base+7u];
	mat.specularIor = inBuf.data[base+8u];
	mat.baseMetalness = inBuf.data[base+9u];
	mat.baseWeight = 1.0f;
	mat.baseColor = f32v3(inBuf.data[base+10u]);
	mat.subsurfaceWeight = 0.0f;
	mat.subsurfaceColor = f32v3(0.0f);
	mat.transmissionWeight = 0.0f;
	mat.transmissionColor = f32v3(0.0f);

	const OpenPbrCoatIblResult result = (
		openPbrCoatIblEvaluate(mat, muI, f32v3(1.0f), /*isInsideMedium=*/ false)
	);
	F32v3Buffer(pc.outVa).data[i] = (
		result.ownReflectance + result.attenuation * f32v3(1.0f)
	);
}
