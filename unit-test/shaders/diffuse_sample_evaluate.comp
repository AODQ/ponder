#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

layout(set = 0, binding = 0) uniform sampler2D vkofTextures[];

#include "util-random.glsl"
#include "util-material-openpbr-tables.glsl"

// constants normally provided by util-material-openpbr.glsl; the full
// material include chain pulls in every lobe, so the diffuse-only prelude
// is replicated here instead (values must match util-material-openpbr.glsl)
#define IPI 0.31830988618379067154
#define PI  3.14159265358979323846
#define TAU 6.28318530717958647692
const float skFon1 = 0.5f - 2.0f / (3.0f * PI);
const float skFon2 = 2.0f / 3.0f - 28.0f / (15.0f * PI);

#include "util-material-openpbr-shared.h"
#include "util-material-openpbr-thinfilm.glsl"
#include "util-material-openpbr-microfacet.glsl"
#include "util-material-openpbr-diffuse.glsl"

layout(buffer_reference, scalar) buffer F32Buffer { f32 data[]; };

// per sample, 5 floats in: nor.xyz, xi.xy. output 10 floats: woGlossy.xyz
// (openPbrGlossyDiffuseSampleWo), pdf at woGlossy
// (openPbrGlossyDiffusePdf(dot(nor, woGlossy))), pad.xy (kept so the
// 10-float layout matches the harness), woCosine.xyz
// (utilCosineHemisphereSampleWo from the same xi; must equal woGlossy
// since the glossy sampler is a pass-through), pad.
layout(push_constant, scalar) uniform PC {
	layout(offset = 128) uint64_t inVa;
	uint64_t outVa;
	uint count;
} pc;

layout(local_size_x = 64) in;

void main() {
	u32 i = gl_GlobalInvocationID.x;
	if (i >= pc.count) { return; }
	F32Buffer inBuf = F32Buffer(pc.inVa);
	u32 base = i * 5u;
	const f32v3 nor = (
		f32v3(inBuf.data[base+0u], inBuf.data[base+1u], inBuf.data[base+2u])
	);
	const f32v2 xi = f32v2(inBuf.data[base+3u], inBuf.data[base+4u]);

	const f32v3 woGlossy = openPbrGlossyDiffuseSampleWo(nor, xi);
	const f32 pdf = openPbrGlossyDiffusePdf(dot(normalize(nor), woGlossy));

	const f32v3 woCosine = utilCosineHemisphereSampleWo(nor, xi);

	F32Buffer outBuf = F32Buffer(pc.outVa);
	outBuf.data[i*10u+0u] = woGlossy.x;
	outBuf.data[i*10u+1u] = woGlossy.y;
	outBuf.data[i*10u+2u] = woGlossy.z;
	outBuf.data[i*10u+3u] = pdf;
	outBuf.data[i*10u+4u] = 0.0f;
	outBuf.data[i*10u+5u] = 0.0f;
	outBuf.data[i*10u+6u] = woCosine.x;
	outBuf.data[i*10u+7u] = woCosine.y;
	outBuf.data[i*10u+8u] = woCosine.z;
	outBuf.data[i*10u+9u] = 0.0f;
}
