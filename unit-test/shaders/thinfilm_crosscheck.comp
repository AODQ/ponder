#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

layout(set = 0, binding = 0) uniform sampler2D vkofTextures[];

#include "util-random.glsl"
#include "util-material-openpbr-tables.glsl"

// constants normally provided by util-material-openpbr.glsl; the full
// material include chain pulls in every lobe, so the lobe-only prelude
// is replicated here instead (values must match util-material-openpbr.glsl)
#define IPI 0.31830988618379067154
#define PI  3.14159265358979323846
#define TAU 6.28318530717958647692
const float skFon1 = 0.5f - 2.0f / (3.0f * PI);
const float skFon2 = 2.0f / 3.0f - 28.0f / (15.0f * PI);

#include "util-material-openpbr-shared.h"
#include "util-material-openpbr-thinfilm.glsl"
#include "util-thinfilm-materialx-reference.glsl"

layout(buffer_reference, scalar) buffer F32Buffer { f32 data[]; };
layout(buffer_reference, scalar) buffer F32v3Buffer { f32v3 data[]; };

// independent cross-check against materialx's mx_fresnel_airy, restricted
// to a real (non-absorbing) base -- kappaBase = 0 on both sides, matching
// how openPbrThinfilmFresnel is actually called in
// util-material-openpbr-metallic.glsl/-microfacet.glsl (both pass an
// effective real ior base, never a complex one -- see thinfilm_evaluate's
// own conductor-base coverage for the kappaBase != 0 branch in isolation).
//
// thickness is restricted to >= 0.03 (see push data) so ponder's
// smoothstep(0, 0.03, thickness) fade-in of eta2 is fully saturated to
// thinFilmIor, matching materialx's unconditional eta2 = max(tf_ior, 1) --
// below that fade-in band the two are not directly comparable (materialx
// has no equivalent ramp).
//
// per sample, 4 floats: cosThetaI, thinFilmThickness (micrometers, >=
// 0.03), thinFilmIor, etaBase (scalar, splatted -- an achromatic base,
// same as the dielectric-specular/microfacet caller)
layout(push_constant, scalar) uniform PC {
	layout(offset = 128) uint64_t inVa;
	uint64_t mineOutVa;
	uint64_t refOutVa;
	uint count;
} pc;

layout(local_size_x = 64) in;

void main() {
	u32 i = gl_GlobalInvocationID.x;
	if (i >= pc.count) { return; }
	F32Buffer inBuf = F32Buffer(pc.inVa);
	u32 base = i * 4u;
	const f32 cosThetaI = inBuf.data[base+0u];
	const f32 thickness = inBuf.data[base+1u];
	const f32 filmIor = inBuf.data[base+2u];
	const f32 etaBaseScalar = inBuf.data[base+3u];

	OpenPbrMaterial mat;
	mat.thinFilmThickness = thickness;
	mat.thinFilmIor = filmIor;

	F32v3Buffer(pc.mineOutVa).data[i] = (
		openPbrThinfilmFresnel(
			mat, cosThetaI, f32v3(etaBaseScalar), f32v3(0.0f)
		)
	);
	F32v3Buffer(pc.refOutVa).data[i] = (
		mxThinfilmFresnel(
			cosThetaI, thickness * 1000.0f, filmIor,
			f32v3(etaBaseScalar), f32v3(0.0f)
		)
	);
}
