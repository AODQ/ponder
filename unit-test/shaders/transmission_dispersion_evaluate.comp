#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

layout(set = 0, binding = 0) uniform sampler2D vkofTextures[];

#include "util-random.glsl"
#include "util-material-openpbr-tables.glsl"

// constants normally provided by util-material-openpbr.glsl; the full
// material include chain pulls in every lobe, so the lobe-only prelude
// is replicated here instead (values must match util-material-openpbr.glsl)
#define IPI 0.31830988618379067154
#define PI  3.14159265358979323846
#define TAU 6.28318530717958647692
const float skFon1 = 0.5f - 2.0f / (3.0f * PI);
const float skFon2 = 2.0f / 3.0f - 28.0f / (15.0f * PI);

#include "util-material-openpbr-shared.h"
#include "util-material-openpbr-thinfilm.glsl"
#include "util-material-openpbr-microfacet.glsl"
#include "util-material-openpbr-transmission.glsl"

layout(buffer_reference, scalar) buffer F32Buffer { f32 data[]; };

// per sample, 3 floats in: specularIor, transmissionDispersionScale,
// transmissionDispersionAbbeNumber. output 3 floats: openPbrDispersionIorRgb
layout(push_constant, scalar) uniform PC {
	layout(offset = 128) uint64_t inVa;
	uint64_t outVa;
	uint count;
} pc;

layout(local_size_x = 64) in;

void main() {
	u32 i = gl_GlobalInvocationID.x;
	if (i >= pc.count) { return; }
	F32Buffer inBuf = F32Buffer(pc.inVa);
	u32 base = i * 3u;

	OpenPbrMaterial mat;
	mat.specularIor = inBuf.data[base+0u];
	// n_d is now the coat-affected, specular_weight-modulated ior; these are
	// its identities, so the golden values stay the plain-specularIor cauchy fit
	mat.specularWeight = 1.0f;
	mat.coatWeight = 0.0f;
	mat.coatIor = 1.0f;
	mat.transmissionDispersionScale = inBuf.data[base+1u];
	mat.transmissionDispersionAbbeNumber = inBuf.data[base+2u];

	const f32v3 iorRgb = openPbrDispersionIorRgb(mat);

	F32Buffer outBuf = F32Buffer(pc.outVa);
	outBuf.data[i*3u+0u] = iorRgb.x;
	outBuf.data[i*3u+1u] = iorRgb.y;
	outBuf.data[i*3u+2u] = iorRgb.z;
}
