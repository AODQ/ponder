#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require

layout(set = 0, binding = 3) uniform accelerationStructureEXT vkofTlas;

layout(buffer_reference, scalar) buffer F32Buffer {
	float data[];
};

layout(push_constant, scalar) uniform PC {
	layout(offset = 128) uint64_t outVa;
	uint width;
	uint height;
} pc;

// brute-force lambertian path tracer over the open-front cornell box.
// primary rays are deterministic (no pixel jitter) so the host can classify
// light vs non-light pixels with the same camera math. output is three
// planar f32 channels (r, g, b) of the per-pixel radiance mean
const vec3 skCameraOrigin = vec3(0.0, 0.0, -3.0);
const float skTanHalfFov = 0.4;
const uint skSampleCount = 256u;
const uint skBounceCount = 8u;

const float skTau = 6.28318530717958647692;

// wall order matches test-cornell.cpp: floor, ceiling, back, left (red),
// right (green), light
const vec3 skWallAlbedo[6] = vec3[6](
	vec3(0.73, 0.73, 0.73),
	vec3(0.73, 0.73, 0.73),
	vec3(0.73, 0.73, 0.73),
	vec3(0.63, 0.065, 0.05),
	vec3(0.14, 0.45, 0.091),
	vec3(0.78, 0.78, 0.78)
);
const vec3 skWallEmission[6] = vec3[6](
	vec3(0.0), vec3(0.0), vec3(0.0), vec3(0.0), vec3(0.0),
	vec3(15.0, 15.0, 15.0)
);
// plane normal per wall; sign is irrelevant, flipped to face the ray
const vec3 skWallNormals[6] = vec3[6](
	vec3(0.0, 1.0, 0.0),
	vec3(0.0, -1.0, 0.0),
	vec3(0.0, 0.0, -1.0),
	vec3(1.0, 0.0, 0.0),
	vec3(-1.0, 0.0, 0.0),
	vec3(0.0, -1.0, 0.0)
);

uint fnPcgHash(uint v) {
	uint state = v * 747796405u + 2891336453u;
	uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
	return (word >> 22u) ^ word;
}

vec2 fnSampleUniform2(inout uint state) {
	state = fnPcgHash(state);
	uint a = state;
	state = fnPcgHash(state);
	uint b = state;
	return vec2(
		uintBitsToFloat((a >> 9u) | 0x3F800000u) - 1.0,
		uintBitsToFloat((b >> 9u) | 0x3F800000u) - 1.0
	);
}

// cosine-weighted hemisphere sample around n; pdf = cos(theta) / pi
vec3 fnSampleCosineHemisphere(vec3 n, vec2 u) {
	float r = sqrt(u.x);
	float phi = skTau * u.y;
	float lz = sqrt(max(0.0, 1.0 - u.x));
	// build an orthonormal basis around n (pixar / duff et al.)
	float s = (n.z >= 0.0) ? 1.0 : -1.0;
	float a = -1.0 / (s + n.z);
	float b = n.x * n.y * a;
	vec3 t = vec3(1.0 + s * n.x * n.x * a, s * b, -s * n.x);
	vec3 bt = vec3(b, s + n.y * n.y * a, -n.y);
	return normalize(
		t * (r * cos(phi)) + bt * (r * sin(phi)) + n * lz
	);
}

layout(local_size_x = 8, local_size_y = 8) in;

void main() {
	uint px = gl_GlobalInvocationID.x;
	uint py = gl_GlobalInvocationID.y;
	if (px >= pc.width || py >= pc.height) { return; }
	uint pixel = py * pc.width + px;

	// ndc in [-1,1]; image row 0 is the top of the frame (+y in world)
	float ndcX = (2.0 * (float(px) + 0.5) / float(pc.width) - 1.0);
	float ndcY = (2.0 * (float(py) + 0.5) / float(pc.height) - 1.0);
	vec3 primaryDir = normalize(
		vec3(ndcX * skTanHalfFov, -ndcY * skTanHalfFov, 1.0)
	);

	uint rngState = pixel * skSampleCount + 1u;
	vec3 radianceSum = vec3(0.0);

	for (uint s = 0u; s < skSampleCount; ++s) {
		vec3 origin = skCameraOrigin;
		vec3 dir = primaryDir;
		vec3 throughput = vec3(1.0);

		for (uint bounce = 0u; bounce < skBounceCount; ++bounce) {
			rayQueryEXT rq;
			rayQueryInitializeEXT(
				/*rayQuery=*/rq,
				/*topLevel=*/vkofTlas,
				/*rayFlags=*/gl_RayFlagsOpaqueEXT,
				/*cullMask=*/0xFF,
				/*origin=*/origin,
				// tMin is zero: self-intersection is prevented by the
				// origin offset along the normal; a positive tMin tunnels
				// through adjacent walls at corners
				/*tMin=*/0.0,
				/*direction=*/dir,
				/*tMax=*/100.0
			);
			while (rayQueryProceedEXT(rq)) { }

			bool hit = (
				rayQueryGetIntersectionTypeEXT(
					/*rayQuery=*/rq, /*committed=*/true
				)
				!= gl_RayQueryCommittedIntersectionNoneEXT
			);
			// escaped through the open front face: no sky emission
			if (!hit) { break; }

			float t = rayQueryGetIntersectionTEXT(
				/*rayQuery=*/rq, /*committed=*/true
			);
			uint wall = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(
				/*rayQuery=*/rq, /*committed=*/true
			));
			vec3 hitPos = origin + t * dir;
			vec3 n = skWallNormals[wall];
			if (dot(n, dir) > 0.0) { n = -n; }

			radianceSum += throughput * skWallEmission[wall];
			// lambertian, cosine-weighted sampling: f * cos / pdf = albedo
			throughput *= skWallAlbedo[wall];

			dir = fnSampleCosineHemisphere(n, fnSampleUniform2(rngState));
			origin = hitPos + n * 0.001;
		}
	}

	vec3 radiance = radianceSum / float(skSampleCount);
	uint pixelCount = pc.width * pc.height;
	F32Buffer outBuf = F32Buffer(pc.outVa);
	outBuf.data[pixel] = radiance.r;
	outBuf.data[pixelCount + pixel] = radiance.g;
	outBuf.data[2u * pixelCount + pixel] = radiance.b;
}
