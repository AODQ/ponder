#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

layout(set = 0, binding = 0) uniform sampler2D vkofTextures[];

#include "util-random.glsl"
#include "util-material-openpbr-tables.glsl"

// constants normally provided by util-material-openpbr.glsl; the full
// material include chain pulls in every lobe, so the diffuse-only prelude
// is replicated here instead (values must match util-material-openpbr.glsl)
#define IPI 0.31830988618379067154
#define PI  3.14159265358979323846
#define TAU 6.28318530717958647692
const float skFon1 = 0.5f - 2.0f / (3.0f * PI);
const float skFon2 = 2.0f / 3.0f - 28.0f / (15.0f * PI);

// test-only shim: ponder's util-random.glsl draws from pcg32 u64 states,
// but the openpbr material shaders (ported from cull) still draw from
// f32v2 seeds. cull's overload (cull app/shaders/util-random.glsl) is
// replicated here so the lib files compile unmodified; see the latent
// incompatibility note in the eon test suite
f32v2 fnSampleUniform2(inout f32v2 seed) {
	u32 s = fnPcgHash(floatBitsToUint(seed.x) ^ floatBitsToUint(seed.y));
	u32 s2 = fnPcgHash(s);
	seed.x = uintBitsToFloat((s >> 9u) | 0x3F800000u) - 1.0f;
	seed.y = uintBitsToFloat((s2 >> 9u) | 0x3F800000u) - 1.0f;
	return seed;
}

#include "util-material-openpbr-shared.h"
#include "util-material-openpbr-thinfilm.glsl"
#include "util-material-openpbr-microfacet.glsl"
#include "util-material-openpbr-diffuse.glsl"

layout(buffer_reference, scalar) buffer F32Buffer { f32 data[]; };
layout(buffer_reference, scalar) buffer F32v3Buffer { f32v3 data[]; };

// furnace test: numerically integrates the eon diffuse lobe over the wo
// hemisphere under constant unit illumination. the whole point of the
// energy-preserving oren-nayer construction is that this integral is
// exactly 1 for baseColor = 1 at every incident angle and roughness.
// baseWeight fixed to 1, gray baseColor supplied per sample.
//
// per sample: f32v3(muI, sigma, colorScalar)
layout(push_constant, scalar) uniform PC {
	layout(offset = 128) uint64_t inVa;
	uint64_t outVa;
	uint thetaSteps;
	uint phiSteps;
	uint count;
} pc;

layout(local_size_x = 64) in;

void main() {
	u32 i = gl_GlobalInvocationID.x;
	if (i >= pc.count) { return; }
	const f32v3 s = F32v3Buffer(pc.inVa).data[i];
	const f32 muI = s.x;

	OpenPbrMaterial mat;
	mat.baseDiffuseRoughness = s.y;
	mat.baseWeight = 1.0f;
	mat.baseColor = f32v3(s.z);

	const f32v3 nor = f32v3(0.0f, 0.0f, 1.0f);
	const f32v3 wi = f32v3(sqrt(max(0.0f, 1.0f - muI * muI)), 0.0f, muI);

	const f32 dTheta = (PI * 0.5f) / f32(pc.thetaSteps);
	const f32 dPhi = (2.0f * PI) / f32(pc.phiSteps);

	f32 sum = 0.0f;
	for (uint ti = 0u; ti < pc.thetaSteps; ++ti) {
		const f32 theta = (f32(ti) + 0.5f) * dTheta;
		const f32 cosThetaO = cos(theta);
		const f32 sinThetaO = sin(theta);
		for (uint pi = 0u; pi < pc.phiSteps; ++pi) {
			const f32 phi = (f32(pi) + 0.5f) * dPhi;
			const f32v3 wo = (
				f32v3(sinThetaO * cos(phi), sinThetaO * sin(phi), cosThetaO)
			);
			const f32v3 f = (
				openPbrGlossyDiffuseOrenNayerEvaluateF(mat, nor, wi, wo)
			);
			sum += f.x * cosThetaO * sinThetaO * dTheta * dPhi;
		}
	}
	F32Buffer(pc.outVa).data[i] = sum;
}
