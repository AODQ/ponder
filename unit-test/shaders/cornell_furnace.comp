#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require

layout(set = 0, binding = 3) uniform accelerationStructureEXT vkofTlas;

layout(buffer_reference, scalar) buffer F32Buffer {
	float data[];
};

layout(push_constant, scalar) uniform PC {
	layout(offset = 128) uint64_t outVa;
	uint width;
	uint height;
} pc;

// closed-box furnace: every surface is lambertian with albedo skAlbedo and
// uniform emission skEmission. the constant field L = Le / (1 - rho) solves
// the rendering equation for any closed geometry, and with cosine-weighted
// sampling the path estimator is zero-variance: every path returns exactly
// Le * (1 - rho^B) / (1 - rho). any deviation is a bug (wrong pdf, wrong
// throughput, geometry leak)
const float skAlbedo = 0.8;
const float skEmission = 0.2;
const uint skBounceCount = 64u;

const float skPi = 3.14159265358979323846;
const float skTau = 6.28318530717958647692;

// plane normal per wall instance (sign is irrelevant: flipped to face the
// incoming ray at every hit). order matches the wall indices in
// test-cornell.cpp: floor, ceiling, back, left, right, light, front
const vec3 skWallNormals[7] = vec3[7](
	vec3(0.0, 1.0, 0.0),
	vec3(0.0, -1.0, 0.0),
	vec3(0.0, 0.0, -1.0),
	vec3(1.0, 0.0, 0.0),
	vec3(-1.0, 0.0, 0.0),
	vec3(0.0, -1.0, 0.0),
	vec3(0.0, 0.0, 1.0)
);

uint fnPcgHash(uint v) {
	uint state = v * 747796405u + 2891336453u;
	uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
	return (word >> 22u) ^ word;
}

vec2 fnSampleUniform2(inout uint state) {
	state = fnPcgHash(state);
	uint a = state;
	state = fnPcgHash(state);
	uint b = state;
	return vec2(
		uintBitsToFloat((a >> 9u) | 0x3F800000u) - 1.0,
		uintBitsToFloat((b >> 9u) | 0x3F800000u) - 1.0
	);
}

// cosine-weighted hemisphere sample around n; pdf = cos(theta) / pi
vec3 fnSampleCosineHemisphere(vec3 n, vec2 u) {
	float r = sqrt(u.x);
	float phi = skTau * u.y;
	float lz = sqrt(max(0.0, 1.0 - u.x));
	// build an orthonormal basis around n (pixar / duff et al.)
	float s = (n.z >= 0.0) ? 1.0 : -1.0;
	float a = -1.0 / (s + n.z);
	float b = n.x * n.y * a;
	vec3 t = vec3(1.0 + s * n.x * n.x * a, s * b, -s * n.x);
	vec3 bt = vec3(b, s + n.y * n.y * a, -n.y);
	return normalize(
		t * (r * cos(phi)) + bt * (r * sin(phi)) + n * lz
	);
}

layout(local_size_x = 8, local_size_y = 8) in;

void main() {
	uint px = gl_GlobalInvocationID.x;
	uint py = gl_GlobalInvocationID.y;
	if (px >= pc.width || py >= pc.height) { return; }

	// primary direction: lat-long mapping over the full sphere, so the
	// furnace is probed in all directions from the box center
	float u = (float(px) + 0.5) / float(pc.width);
	float v = (float(py) + 0.5) / float(pc.height);
	float cosTheta = 2.0 * v - 1.0;
	float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
	float phi = skTau * u;
	vec3 dir = vec3(
		sinTheta * cos(phi), cosTheta, sinTheta * sin(phi)
	);
	vec3 origin = vec3(0.0, 0.0, 0.0);

	uint rngState = py * pc.width + px + 1u;
	float radiance = 0.0;
	float throughput = 1.0;

	for (uint bounce = 0u; bounce < skBounceCount; ++bounce) {
		rayQueryEXT rq;
		rayQueryInitializeEXT(
			/*rayQuery=*/rq,
			/*topLevel=*/vkofTlas,
			/*rayFlags=*/gl_RayFlagsOpaqueEXT,
			/*cullMask=*/0xFF,
			/*origin=*/origin,
			// tMin is zero: self-intersection is prevented by offsetting
			// the origin 0.001 along the normal instead. a positive tMin
			// would tunnel through adjacent walls at corners, where the
			// origin can sit arbitrarily close to the perpendicular wall
			/*tMin=*/0.0,
			/*direction=*/dir,
			/*tMax=*/100.0
		);
		while (rayQueryProceedEXT(rq)) { }

		bool hit = (
			rayQueryGetIntersectionTypeEXT(/*rayQuery=*/rq, /*committed=*/true)
			!= gl_RayQueryCommittedIntersectionNoneEXT
		);
		// a miss means the ray leaked out of the closed box; the pixel ends
		// up short of the analytic value and fails the tolerance check
		if (!hit) { break; }

		float t = rayQueryGetIntersectionTEXT(/*rayQuery=*/rq, /*committed=*/true);
		uint wall = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(
			/*rayQuery=*/rq, /*committed=*/true
		));
		vec3 hitPos = origin + t * dir;
		vec3 n = skWallNormals[wall];
		if (dot(n, dir) > 0.0) { n = -n; }

		radiance += throughput * skEmission;
		// lambertian with cosine-weighted sampling: f * cos / pdf = albedo
		throughput *= skAlbedo;

		dir = fnSampleCosineHemisphere(n, fnSampleUniform2(rngState));
		origin = hitPos + n * 0.001;
	}

	F32Buffer(pc.outVa).data[py * pc.width + px] = radiance;
}
