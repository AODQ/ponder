#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

layout(set = 0, binding = 0) uniform sampler2D vkofTextures[];

#include "util-material-openpbr-tables.glsl"

#define IPI 0.31830988618379067154
#define PI  3.14159265358979323846
#define TAU 6.28318530717958647692
const float skFon1 = 0.5f - 2.0f / (3.0f * PI);
const float skFon2 = 2.0f / 3.0f - 28.0f / (15.0f * PI);

#include "util-material-openpbr-shared.h"
#include "util-material-openpbr-thinfilm.glsl"
#include "util-material-openpbr-microfacet.glsl"
#include "util-material-openpbr-ibl.glsl"

layout(buffer_reference, scalar) buffer F32Buffer { f32 data[]; };
layout(buffer_reference, scalar) buffer F32v3Buffer { f32v3 data[]; };

// 20-float sample: muI, dotCoatNorWi, irradianceScalar,
// prefilteredSpecularBaseScalar, prefilteredSpecularCoatScalar,
// baseWeight, baseColorScalar, baseMetalness, specularWeight,
// specularColorScalar, specularRoughness, specularIor, coatWeight,
// coatRoughness, coatIor, coatDarkening, coatColorScalar, fuzzWeight,
// fuzzColorScalar, fuzzRoughness
layout(push_constant, scalar) uniform PC {
	layout(offset = 128) uint64_t inVa;
	uint64_t outVa;
	uint zeltnerLtcParamHandle;
	uint count;
} pc;

layout(local_size_x = 64) in;

void main() {
	u32 i = gl_GlobalInvocationID.x;
	if (i >= pc.count) { return; }
	F32Buffer inBuf = F32Buffer(pc.inVa);
	u32 base = i * 20u;
	const f32 muI = inBuf.data[base+0u];
	const f32 dotCoatNorWi = inBuf.data[base+1u];
	const f32v3 irradiance = f32v3(inBuf.data[base+2u]);
	const f32v3 prefilteredSpecularBase = f32v3(inBuf.data[base+3u]);
	const f32v3 prefilteredSpecularCoat = f32v3(inBuf.data[base+4u]);

	OpenPbrMaterial mat;
	mat.baseWeight = inBuf.data[base+5u];
	mat.baseColor = f32v3(inBuf.data[base+6u]);
	mat.baseMetalness = inBuf.data[base+7u];
	mat.specularWeight = inBuf.data[base+8u];
	mat.specularColor = f32v3(inBuf.data[base+9u]);
	mat.specularRoughness = inBuf.data[base+10u];
	mat.specularRoughnessAnisotropy = 0.0f;
	mat.specularIor = inBuf.data[base+11u];
	mat.coatWeight = inBuf.data[base+12u];
	mat.coatRoughness = inBuf.data[base+13u];
	mat.coatRoughnessAnisotropy = 0.0f;
	mat.coatIor = inBuf.data[base+14u];
	mat.coatDarkening = inBuf.data[base+15u];
	mat.coatColor = f32v3(inBuf.data[base+16u]);
	mat.fuzzWeight = inBuf.data[base+17u];
	mat.fuzzColor = f32v3(inBuf.data[base+18u]);
	mat.fuzzRoughness = inBuf.data[base+19u];
	mat.subsurfaceWeight = 0.0f;
	mat.subsurfaceColor = f32v3(0.0f);
	mat.transmissionWeight = 0.0f;
	mat.transmissionColor = f32v3(0.0f);
	mat.thinFilmWeight = 0.0f;

	const MaterialTableHandles tables = MaterialTableHandles(0u, pc.zeltnerLtcParamHandle);

	F32v3Buffer(pc.outVa).data[i] = (
		openPbrIblEvaluateF(
			tables, mat, muI, dotCoatNorWi, irradiance,
			prefilteredSpecularBase, prefilteredSpecularCoat,
			/*isInsideMedium=*/ false
		)
	);
}
