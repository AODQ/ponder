#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

// observed side of openPbrThinWalledSubsurfaceSampleWo vs
// openPbrThinWalledSubsurfacePdf's chi-square: draws pc.sampleCount
// directions and bins them over the full sphere around pc.nor, same
// convention as subsurface_entry_histogram.comp.

layout(set = 0, binding = 0) uniform sampler2D vkofTextures[];

#include "util-random.glsl"
#include "util-material-openpbr-tables.glsl"

#define IPI 0.31830988618379067154
#define PI  3.14159265358979323846
#define TAU 6.28318530717958647692
const float skFon1 = 0.5f - 2.0f / (3.0f * PI);
const float skFon2 = 2.0f / 3.0f - 28.0f / (15.0f * PI);

#include "util-material-openpbr-shared.h"
#include "util-material-openpbr-thinfilm.glsl"
#include "util-material-openpbr-microfacet.glsl"
#include "util-material-openpbr-diffuse.glsl"
#include "util-sampling-bins.glsl"

layout(buffer_reference, scalar) buffer U32Buffer { u32 data[]; };

layout(push_constant, scalar) uniform PC {
	layout(offset = 128) uint64_t histogramVa;
	uint sampleCount;
	uint seedSalt;
	vec3 nor;
	float anisotropy;
} pc;

layout(local_size_x = 256) in;

void main() {
	const uint sampleIndex = gl_GlobalInvocationID.x;
	if (sampleIndex >= pc.sampleCount) {
		return;
	}

	const uint h0 = fnPcgHash(sampleIndex + fnPcgHash(pc.seedSalt));
	const uint h1 = fnPcgHash(h0);
	u64 state = (u64(h0) << 32) | u64(h1);

	// same draw order as openPbrSampleWo's thin-walled branch
	const vec2 xi = fnSampleUniform2(state);
	const float uSide = fnSampleUniform(state);
	const vec3 dir = (
		openPbrThinWalledSubsurfaceSampleWo(pc.nor, pc.anisotropy, xi, uSide)
	);

	const bool finite = (
		!isnan(dir.x) && !isnan(dir.y) && !isnan(dir.z)
		&& !isinf(dir.x) && !isinf(dir.y) && !isinf(dir.z)
	);
	const bool unit = finite && abs(length(dir) - 1.0f) < 1e-2f;
	const uint bin = (
		unit
		? bsdfVerifyDirectionToBin(pc.nor, dir)
		: BSDF_VERIFY_BIN_COUNT
	);

	atomicAdd(U32Buffer(pc.histogramVa).data[bin], 1u);
}
