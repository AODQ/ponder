#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

layout(set = 0, binding = 0) uniform sampler2D vkofTextures[];

#include "util-random.glsl"
#include "util-material-openpbr-tables.glsl"

// constants normally provided by util-material-openpbr.glsl; the full
// material include chain pulls in every lobe, so the lobe-only prelude
// is replicated here instead (values must match util-material-openpbr.glsl)
#define IPI 0.31830988618379067154
#define PI  3.14159265358979323846
#define TAU 6.28318530717958647692
const float skFon1 = 0.5f - 2.0f / (3.0f * PI);
const float skFon2 = 2.0f / 3.0f - 28.0f / (15.0f * PI);

#include "util-material-openpbr-shared.h"
#include "util-material-openpbr-thinfilm.glsl"
#include "util-material-openpbr-microfacet.glsl"
#include "util-material-openpbr-transmission.glsl"

layout(buffer_reference, scalar) buffer F32Buffer { f32 data[]; };

// per sample, 14 floats in: wi.xyz, wo.xyz, ior, specularRoughness,
// geometryThinWalled, isInsideMedium (0/1), transmissionColor.rgb,
// transmissionDepth. output 6 floats: f.rgb (openPbrTransmissionEvaluateF),
// pdf (openPbrTransmissionPdf), tirReflectPdf
// (openPbrTransmissionTirReflectPdf). dispersedIor is passed as the flat
// ior (dispersion has its own dedicated shader). canonical local frame:
// nor = (0,0,1), wi/wo live directly in it.
layout(push_constant, scalar) uniform PC {
	layout(offset = 128) uint64_t inVa;
	uint64_t outVa;
	uint count;
} pc;

layout(local_size_x = 64) in;

void main() {
	u32 i = gl_GlobalInvocationID.x;
	if (i >= pc.count) { return; }
	F32Buffer inBuf = F32Buffer(pc.inVa);
	u32 base = i * 14u;
	const f32v3 wi = (
		f32v3(inBuf.data[base+0u], inBuf.data[base+1u], inBuf.data[base+2u])
	);
	const f32v3 wo = (
		f32v3(inBuf.data[base+3u], inBuf.data[base+4u], inBuf.data[base+5u])
	);
	const f32 ior = inBuf.data[base+6u];

	OpenPbrMaterial mat;
	mat.specularIor = ior;
	mat.specularRoughness = inBuf.data[base+7u];
	mat.geometryThinWalled = inBuf.data[base+8u];
	const bool isInsideMedium = inBuf.data[base+9u] > 0.5f;
	mat.transmissionColor = (
		f32v3(inBuf.data[base+10u], inBuf.data[base+11u], inBuf.data[base+12u])
	);
	mat.transmissionDepth = inBuf.data[base+13u];
	mat.transmissionDispersionScale = 0.0f;
	mat.transmissionDispersionAbbeNumber = 0.0f;

	const f32v3 nor = f32v3(0.0f, 0.0f, 1.0f);

	const f32v3 f = (
		openPbrTransmissionEvaluateF(mat, nor, wi, wo, isInsideMedium, ior)
	);
	const f32 pdf = (
		openPbrTransmissionPdf(mat, nor, wi, wo, isInsideMedium, ior)
	);
	const f32 tirPdf = (
		openPbrTransmissionTirReflectPdf(mat, nor, wi, wo, isInsideMedium, ior)
	);

	F32Buffer outBuf = F32Buffer(pc.outVa);
	outBuf.data[i*6u+0u] = f.x;
	outBuf.data[i*6u+1u] = f.y;
	outBuf.data[i*6u+2u] = f.z;
	outBuf.data[i*6u+3u] = pdf;
	outBuf.data[i*6u+4u] = tirPdf;
	outBuf.data[i*6u+5u] = 0.0f;
}
