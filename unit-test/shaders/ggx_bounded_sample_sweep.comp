#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

// dense parameter-space sweep hunting for NaN/Inf and degenerate output in
// the ggx samplers. one thread per (incidence x alpha) texel; each texel
// exercises an 8x8 xi grid that includes the exact 0 and 1 endpoints
// (the degenerate strata a random fuzz would almost never hit).

layout(set = 0, binding = 0) uniform sampler2D vkofTextures[];

#include "util-random.glsl"
#include "util-material-openpbr-tables.glsl"

// constants normally provided by util-material-openpbr.glsl; the full
// material include chain pulls in every lobe, so the lobe-only prelude
// is replicated here instead (values must match util-material-openpbr.glsl)
#define IPI 0.31830988618379067154
#define PI  3.14159265358979323846
#define TAU 6.28318530717958647692
const float skFon1 = 0.5f - 2.0f / (3.0f * PI);
const float skFon2 = 2.0f / 3.0f - 28.0f / (15.0f * PI);

#include "util-material-openpbr-shared.h"
#include "util-material-openpbr-thinfilm.glsl"
#include "util-material-openpbr-microfacet.glsl"

#define SWEEP_MODE_GGX_BOUNDED_WO 0u
#define SWEEP_MODE_GGX_VNDF_H 1u

layout(buffer_reference, scalar) buffer F32Buffer { f32 data[]; };

// texel (x, y) maps to cosThetaI in [-1, 1] over x (below-horizon wi
// included: the pdf has a dedicated i.z < 0 branch) and alphaX in
// [1e-5, 1] over y. alphaY = alphaX * alphaYScale (clamped to the same
// floor). output 4 floats per texel: nonFiniteCount, maxUnitLengthError,
// minPdf, maxPdf (pdf outputs are 0 for the vndf mode, which has no
// ponder-side pdf function; its h is checked for finiteness/unit length
// and upper-hemisphere placement via minPdf carrying min(h.z) instead).
layout(push_constant, scalar) uniform PC {
	layout(offset = 128) uint64_t outVa;
	uint mode;
	uint width;
	uint height;
	f32 alphaYScale;
} pc;

layout(local_size_x = 8, local_size_y = 8) in;

void main() {
	const u32v2 texel = gl_GlobalInvocationID.xy;
	if (texel.x >= pc.width || texel.y >= pc.height) { return; }

	const f32 cosThetaI = (
		-1.0f + 2.0f * f32(texel.x) / f32(pc.width - 1u)
	);
	const f32 sinThetaI = sqrt(max(0.0f, 1.0f - cosThetaI * cosThetaI));
	const f32v3 wi = f32v3(sinThetaI, 0.0f, cosThetaI);
	const f32 alphaX = (
		max(1e-5f, f32(texel.y) / f32(pc.height - 1u))
	);
	const f32v2 alpha = f32v2(alphaX, max(1e-5f, alphaX * pc.alphaYScale));

	const f32v3 tanX = f32v3(1.0f, 0.0f, 0.0f);
	const f32v3 tanY = f32v3(0.0f, 1.0f, 0.0f);
	const f32v3 nor = f32v3(0.0f, 0.0f, 1.0f);

	f32 nonFiniteCount = 0.0f;
	f32 maxLenErr = 0.0f;
	f32 minPdf = 1e30f;
	f32 maxPdf = 0.0f;

	const u32 kXiSteps = 8u;
	for (u32 xj = 0u; xj < kXiSteps; ++xj) {
		for (u32 xk = 0u; xk < kXiSteps; ++xk) {
			// xi spans [0, 0.875]: 0 is included (fnUintToUniform emits it),
			// but the xi -> 1 limit is deliberately excluded here. xi.y -> 1
			// places the cap sample exactly on the eq 5 cut boundary, where
			// pdf-side support reconstruction flickers to zero by fp noise;
			// that band is characterized by its own dedicated test rather
			// than folded into this full-domain NaN sweep
			const f32v2 xi = f32v2(
				f32(xj) / f32(kXiSteps),
				f32(xk) / f32(kXiSteps)
			);
			f32v3 dir;
			f32 pdf;
			if (pc.mode == SWEEP_MODE_GGX_BOUNDED_WO) {
				dir = (
					utilMicrofacetSampleGgxBoundedWoAniso(
						tanX, tanY, nor, wi, alpha, xi
					)
				);
				pdf = (
					utilMicrofacetGgxBoundedReflectPdfAniso(
						tanX, tanY, nor, wi, dir, alpha
					)
				);
			} else {
				dir = (
					utilMicrofacetSampleGgxVndf(nor, wi, alpha.x, xi)
				);
				// no ponder-side pdf for the raw vndf h; carry min(h.z)
				// through the pdf channels so the host can assert the
				// half-vector never dips below the horizon
				pdf = dir.z;
			}
			const bool finite = (
				!isnan(dir.x) && !isnan(dir.y) && !isnan(dir.z)
				&& !isinf(dir.x) && !isinf(dir.y) && !isinf(dir.z)
				&& !isnan(pdf) && !isinf(pdf)
			);
			if (!finite) {
				nonFiniteCount += 1.0f;
				continue;
			}
			maxLenErr = max(maxLenErr, abs(length(dir) - 1.0f));
			minPdf = min(minPdf, pdf);
			maxPdf = max(maxPdf, pdf);
		}
	}

	F32Buffer outBuf = F32Buffer(pc.outVa);
	const u32 base = (texel.y * pc.width + texel.x) * 4u;
	outBuf.data[base+0u] = nonFiniteCount;
	outBuf.data[base+1u] = maxLenErr;
	outBuf.data[base+2u] = minPdf;
	outBuf.data[base+3u] = maxPdf;
}
