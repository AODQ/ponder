#version 460

#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require

layout(set = 0, binding = 0) uniform sampler2D vkofTextures[];
layout(set = 0, binding = 1) uniform uimage2D vkofImagesU[];
layout(set = 0, binding = 2) uniform image2D vkofImages[];
layout(set = 0, binding = 3) uniform accelerationStructureEXT vkofTlas;
layout(set = 0, binding = 4) uniform sampler3D vkofTextures3D[];

#include "env-prefilter-pc.h"
#include "util-environment-map.glsl"
#include "util-material-openpbr.glsl"
#include "util-env-prefilter.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// -----------------------------------------------------------------------------
// -- entry point
// -----------------------------------------------------------------------------

// karis' split-sum prefilter : importance-sample the ggx half-vector
void main() {
	const ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
	if (
		coord.x >= int(pc.prefilter.dstWidth)
		|| coord.y >= int(pc.prefilter.dstHeight)
	) {
		return;
	}
	const vec2 uv = (
		(vec2(coord) + 0.5f)
		/ vec2(pc.prefilter.dstWidth, pc.prefilter.dstHeight)
	);
	const vec3 n = environmentMapUvToDir(uv, 0.0f);

	// sampling a raw, full-res source point-hits or misses a small bright
	// feature (e.g. a sun disc) with no middle ground -- no sample count
	// converges that. per-sample pdf-based mip selection (krivanek & colbert
	// 2008, see envPrefilterComputeLod) reads an already-averaged, coarser
	// source mip when a sample represents a wide solid angle, matching
	// materialx's mx_generate_prefilter_env.glsl
	const float maxMipLevel = float(pc.prefilter.srcRadianceMipCount - 1u);
	const float alpha = pc.prefilter.roughness;

	vec3 sum = vec3(0.0f);
	float weightSum = 0.0f;
	const uint sampleCount = pc.prefilter.sampleCount;
	for (uint i = 0u; i < sampleCount; ++i) {
		const vec2 xi = envPrefilterHammersley(i, sampleCount);
		const vec3 h = envPrefilterImportanceSampleH(xi, alpha, n);
		const vec3 wo = reflect(-n, h);
		const float dotNorWo = max(dot(n, wo), 0.0f);
		if (dotNorWo > 0.0f) {
			const float dotNorH = max(dot(n, h), 0.0f);
			const float d = utilMicrofacetGgxDistribution(dotNorH, alpha);
			const float g1 = utilMicrofacetSmithG1(1.0f, alpha);
			const float pdf = d * g1 / 4.0f;
			const float lod = (
				envPrefilterComputeLod(wo, pdf, maxMipLevel, sampleCount)
			);
			const vec2 srcUv = environmentMapDirToUv(wo, 0.0f);
			sum += (
				textureLod(vkofTextures[pc.prefilter.srcRadianceHandle], srcUv, lod).rgb
				* dotNorWo
			);
			weightSum += dotNorWo;
		}
	}
	const vec3 result = weightSum > 0.0f ? sum / weightSum : vec3(0.0f);

	imageStore(vkofImages[pc.prefilter.dstStorageHandle], coord, vec4(result, 1.0f));
}
