implementing util;

import types;

namespace vkof {

// cie d65 illuminant, 360-830 nm in 5 nm steps, scaled to luminance 1
static const f32 skD65[95] = {
	0.471804f, 0.499375f, 0.526946f, 0.516255f, 0.505564f, 0.529199f, 0.552834f,
	0.695001f, 0.837169f, 0.881331f, 0.925494f, 0.935337f, 0.945179f, 0.911038f,
	0.876899f, 0.968869f, 1.060840f, 1.122255f, 1.183681f, 1.187748f, 1.191815f,
	1.176883f, 1.161962f, 1.167333f, 1.172705f, 1.136732f, 1.100758f, 1.103500f,
	1.106251f, 1.098401f, 1.090551f, 1.075316f, 1.060081f, 1.074739f, 1.089408f,
	1.072797f, 1.056186f, 1.054365f, 1.052554f, 1.032089f, 1.011624f, 0.993082f,
	0.974540f, 0.971777f, 0.969015f, 0.933090f, 0.897165f, 0.903845f, 0.910524f,
	0.908465f, 0.906406f, 0.896794f, 0.887181f, 0.864874f, 0.842568f, 0.844644f,
	0.846721f, 0.828146f, 0.809570f, 0.810520f, 0.811470f, 0.821906f, 0.832342f,
	0.812142f, 0.791942f, 0.748629f, 0.705318f, 0.714866f, 0.724415f, 0.738273f,
	0.752132f, 0.687667f, 0.623201f, 0.665090f, 0.706980f, 0.733289f, 0.759598f,
	0.701458f, 0.643319f, 0.556448f, 0.469578f, 0.572699f, 0.675820f, 0.658508f,
	0.641196f, 0.645855f, 0.650515f, 0.625972f, 0.601430f, 0.563529f, 0.525630f,
	0.553356f, 0.581083f, 0.595609f, 0.610136f,
};

public func cieD65(λ: f32) -> f32 {
	let f: f32 = clamp((λ - skLambdaMin) / 5.0f, 0.0f, 94.0f);
	let i: u32 = min(u32(f), 93u);
	return lerp(skD65[i], skD65[i + 1u], f - f32(i));
}

// cie xyz -> linear rec.709 primaries, d65 white;
// out-of-gamut colors go negative
public func xyzToLinearRec709(xyz: f32v3) -> f32v3 {
	return f32v3(
		3.2404542f * xyz.x - 1.5371385f * xyz.y - 0.4985314f * xyz.z,
		-0.9692660f * xyz.x + 1.8760108f * xyz.y + 0.0415560f * xyz.z,
		0.0556434f * xyz.x - 0.2040255f * xyz.y + 1.0572252f * xyz.z
	);
}

} // namespace vkof
