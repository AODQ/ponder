#version 450
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_GOOGLE_include_directive : require

#include "shared/scene.h"

layout(local_size_x = 32) in;
layout(triangles, max_vertices = 64, max_primitives = 124) out;

layout(location = 0) flat out uint outVisibility[];

void main() {
	GpuMorMeshletBuffer meshletBuf = GpuMorMeshletBuffer(pc.draw.meshlets);
	const GpuMorMeshlet meshlet = meshletBuf.data[gl_WorkGroupID.x];
	GpuMorInstanceBuffer instanceBuf = GpuMorInstanceBuffer(pc.draw.instances);
	const mat4 transform = (
		pc.draw.modelMatrix * instanceBuf.data[meshlet.instanceIndex].transform
	);

	GpuMorPositionBuffer posBuf = GpuMorPositionBuffer(pc.draw.positions);
	GpuMorMeshletVertBuffer vertBuf = (
		GpuMorMeshletVertBuffer(pc.draw.meshletVerts)
	);
	GpuMorMeshletTriBuffer triBuf = GpuMorMeshletTriBuffer(pc.draw.meshletTris);

	SetMeshOutputsEXT(meshlet.vertexCount, meshlet.triangleCount);

	const uint localIndex = gl_LocalInvocationID.x;

	// -- emit vertex attributes
	for (uint i = 0; i < meshlet.vertexCount / gl_WorkGroupSize.x + 1; ++i) {
		const uint vertIndex = i*gl_WorkGroupSize.x + localIndex;
		if (vertIndex >= meshlet.vertexCount) { continue; }
		const uint globalIdx = vertBuf.data[meshlet.vertexOffset + vertIndex];
		// -- emit position
		const vec4 worldPos = transform * vec4(posBuf.data[globalIdx], 1.0f);
		gl_MeshVerticesEXT[vertIndex].gl_Position = (
			pc.global.viewProj * worldPos
		);
		// -- emit visibility attribute
		const uint modelId = pc.draw.modelId;
		const uint meshLocalId = gl_WorkGroupID.x;
		// visibility mask is: modelId 8b, meshLocalId 17b, triangleId 7b
		// fragment shader will handle triangleId as gl_PrimitiveID
		outVisibility[vertIndex] = (modelId << 24) | ((meshLocalId + 1u) << 7);
	}

	// -- emit triangle indices
	for (uint i = 0; i < meshlet.triangleCount / gl_WorkGroupSize.x + 1; ++i) {
		const uint triIndex = i*gl_WorkGroupSize.x + localIndex;
		if (triIndex >= meshlet.triangleCount) { continue; }
		const uint base = meshlet.triangleOffset + triIndex*3;
		gl_PrimitiveTriangleIndicesEXT[triIndex] = (
			uvec3(
				uint(triBuf.data[base + 0]),
				uint(triBuf.data[base + 1]),
				uint(triBuf.data[base + 2])
			)
		);
		gl_MeshPrimitivesEXT[triIndex].gl_PrimitiveID = int(triIndex);
	}
}
